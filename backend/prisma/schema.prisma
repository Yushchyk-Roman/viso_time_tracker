generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id        Int         @id @default(autoincrement())
  name      String      @unique
  color     String      @default("blue")
}

model TimeEntry {
  id          Int      @id @default(autoincrement())
  date        DateTime
  projectName String
  hours       Float
  description String
  createdAt   DateTime @default(now())
}